# PUBLIC Firebase web configuration. These values are embedded in the browser bundle.
# Copy to .env.local; never put service-account keys or OAuth secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Leave empty for the safe sign-in/UID-copy onboarding flow; no database access.
# Must match the UID compiled into deployed Firestore Rules.
VITE_OWNER_UID=
# Local development ONLY. Never enable in the GitHub production variables.
VITE_USE_EMULATORS=false
